    public User getUserByUsernameAndPassword(String username, String password) {
        // Implement logic to retrieve a user by their username
        Optional<User> userOptional = usersRepository.findByUsername(username);
        log.info("User found: {}", userOptional.isPresent());
        if (userOptional.isEmpty()) {
            return null;
        }
        
        
        User existingUser = userOptional.get();
        
        Boolean passwordMatches = verifyPassword(existingUser, password);
        log.info("Password matches: {}", passwordMatches);
        if (!passwordMatches) {
            return null; // Password is incorrect
        }

        return existingUser; // User found and password is correct
    }

    public boolean verifyPassword(User existingUser, String password) {
        log.info("Verifying password for user: {}", existingUser.getUsername());
        return passwordEncoder.matches(password, existingUser.getPasswordHash());
    }


}
